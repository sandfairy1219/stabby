<UserControl x:Class="Stabby.Views.AudioMixerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Stabby.Models"
             xmlns:converters="clr-namespace:Stabby.Converters">
    <UserControl.Resources>
        <converters:CaptureModeDisplayConverter x:Key="CaptureModeDisplayConverter"/>
        <ObjectDataProvider x:Key="CaptureModeValues" MethodName="GetValues" ObjectType="{x:Type models:CaptureMode}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:CaptureMode"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>
    <Border BorderBrush="#333333" BorderThickness="1" Background="#222222" CornerRadius="4" Padding="12">
        <StackPanel>
            <TextBlock Text="Audio Mixer" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400">
                <ItemsControl ItemsSource="{Binding AudioSessions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" Width="80"
                                          ItemsSource="{Binding Source={StaticResource CaptureModeValues}}"
                                          SelectedItem="{Binding CaptureMode, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource CaptureModeDisplayConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DisplayName}" 
                                           Foreground="White" 
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextTrimming="None"
                                           ToolTip="{Binding DisplayName}"
                                           MaxHeight="40"
                                           Margin="8,0"/>
                                <Slider Grid.Column="2" 
                                        Minimum="0" Maximum="100" 
                                        Value="{Binding Volume, Mode=TwoWay}" 
                                        VerticalAlignment="Center"
                                        Margin="4,0"/>
                                <CheckBox Grid.Column="3" 
                                          Content="Mute" 
                                          IsChecked="{Binding IsMuted, Mode=TwoWay}" 
                                          Foreground="White" 
                                          VerticalAlignment="Center"
                                          FontSize="11"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Border>
</UserControl>
