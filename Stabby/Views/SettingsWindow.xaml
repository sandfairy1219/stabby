<Window x:Class="Stabby.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="360" Width="420"
        Background="#1a1a1a"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Output Directory" Foreground="White" FontWeight="Bold" Margin="0,8"/>
        <TextBox Grid.Row="1" Text="{Binding OutputDirectory}" Background="#333" Foreground="White" Padding="6"/>

        <TextBlock Grid.Row="2" Text="Frame Rate" Foreground="White" FontWeight="Bold" Margin="0,8"/>
        <TextBox Grid.Row="3" Text="{Binding FrameRate}" Background="#333" Foreground="White" Padding="6"/>

        <TextBlock Grid.Row="4" Text="Video CRF (lower = better quality)" Foreground="White" FontWeight="Bold" Margin="0,8"/>
        <TextBox Grid.Row="5" Text="{Binding VideoCrf}" Background="#333" Foreground="White" Padding="6"/>

        <TextBlock Grid.Row="6" Text="Audio Bitrate (kbps)" Foreground="White" FontWeight="Bold" Margin="0,8"/>
        <TextBox Grid.Row="7" Text="{Binding AudioBitrate}" Background="#333" Foreground="White" Padding="6"/>

        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Save" Command="{Binding SaveCommand}" Background="#cc3333" Foreground="White" Padding="16,6" Margin="4"/>
            <Button Content="Cancel" Click="Cancel_Click" Background="#333" Foreground="White" Padding="16,6" Margin="4"/>
        </StackPanel>
    </Grid>
</Window>
