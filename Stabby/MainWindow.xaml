<Window x:Class="Stabby.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Stabby.Views"
        Title="Stabby" Height="700" Width="1100"
        Background="#111111">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1a1a1a" Padding="8">
            <StackPanel Orientation="Horizontal">
                <Button Content="Record" Command="{Binding StartRecordingCommand}" Foreground="White" Background="#cc3333" Padding="16,6" Margin="4" FontWeight="Bold"/>
                <Button Content="Stop" Command="{Binding StopRecordingCommand}" Foreground="White" Background="#333333" Padding="16,6" Margin="4"/>
                <Button Content="{Binding PauseButtonText}" Command="{Binding PauseCommand}" Foreground="White" Background="#333333" Padding="16,6" Margin="4"/>
                <Button Content="Settings" Command="{Binding SettingsCommand}" Foreground="White" Background="#333333" Padding="16,6" Margin="4"/>
                <Button Content="Select Source" Click="SelectSource_Click" Foreground="White" Background="#444444" Padding="16,6" Margin="4"/>
                <Border Background="#333333" CornerRadius="4" Margin="8,0,0,0" Padding="10,0">
                    <TextBlock Text="{Binding CaptureSourceName}" Foreground="#aaaaaa" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" x:Name="PreviewGrid" SizeChanged="PreviewGrid_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#000000" Margin="12" CornerRadius="4"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    Width="{Binding PreviewContainerWidth}" Height="{Binding PreviewContainerHeight}">
                <Image Source="{Binding PreviewImage}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" Background="#666666" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ShowsPreview="False"/>

            <views:AudioMixerPanel Grid.Column="2" Margin="0,12,12,12" DataContext="{Binding}"/>
        </Grid>

        <StatusBar Grid.Row="2" Background="#1a1a1a">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" Foreground="White"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
